# Build subdirectories.
/*build*
!/build-aux
!/build_msvc

*.pyc

# Only ignore unexpected patches
*.patch
!contrib/guix/patches/*.patch
!depends/patches/**/*.patch

/CMakeUserPresets.json

# Previous releases
/releases

#build tests
test/lint/test_runner/target/

/guix-build-*

/ci/scratch/

# IDE / editor (CMake Tools, VS, VS Code, clangd)
.vs/
.vscode/
.idea/
.cache/
*.user
*.suo
CMakeSettings.json

# VS / CMake Tools default binary dir (not /*build*)
/out/

# In-tree compile DB if a generator drops it at the root
/compile_commands.json

# Local cmake / VS leftovers (/*build* already covers build/ and build-vs-static/)
/vcpkg_installed/
/Testing/
*.obj
*.pdb
*.ilk
*.idb

